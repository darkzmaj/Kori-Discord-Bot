######################################################################################
# Kori configuration. Copy to .env (the installer does this for you) and fill in.
# Only DISCORD_TOKEN is required. Everything else is optional.
# Never commit .env: it holds your bot token and webhook URLs.
######################################################################################

# Bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
# On the same page, turn on "Message Content Intent" so ticket transcripts include message text.
DISCORD_TOKEN=
# Application ID (General Information page). Optional safety check that the token belongs to this app.
APPLICATION_ID=
# Where the SQLite database lives (ignored in Docker, which always uses /app/data/kori.sqlite).
DATABASE_PATH=./data/kori.sqlite

######################################################################################
# OWNER'S LOG (optional): bot health, plus ticket activity from LOG_GUILD_ID only
#   Bot started, stopped, failed, joined or left a server (every server); and, for your own server,
#   tickets opened, claimed, closed and deleted, members added and removed, /ticket changes.
#   Every server (yours included) can instead pick its own log channel in /ticket -> Logs.
#   Other servers' ticket activity never reaches this webhook.
# Create a webhook in your log channel (Channel Settings -> Integrations -> Webhooks) and paste its
# URL. The guild and channel IDs must match the webhook, or Kori refuses to send to it.
# Set all three or leave all three empty.
######################################################################################

LOG_WEBHOOK_URL=
LOG_GUILD_ID=
LOG_CHANNEL_ID=

######################################################################################
# OWNER'S TRANSCRIPT LOG (optional): .txt transcripts from TRANSCRIPT_GUILD_ID only
#   Other servers' transcripts never reach this webhook; each server picks its own channel in
#   /ticket -> Logs.
#   Each closed ticket posts a summary (title, opened/claimed/closed by, reason, participants,
#   creation and deletion time) with the full transcript attached. The ticket opener also gets
#   the same summary and transcript by DM, whether or not this log is configured.
# Use a different channel and webhook from the main log. Set all three or leave all three empty.
######################################################################################

TRANSCRIPT_WEBHOOK_URL=
TRANSCRIPT_GUILD_ID=
TRANSCRIPT_CHANNEL_ID=

######################################################################################
# DIAGNOSTICS (optional, used only by `rake commands:inspect`)
######################################################################################

DIAGNOSTIC_GUILD_ID=
DIAGNOSTIC_USER_ID=
